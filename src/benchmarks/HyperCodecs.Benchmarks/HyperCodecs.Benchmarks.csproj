<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- On Windows the benchmarks run against the Windows build of HyperCodecs.Platform, as the tests do. -->
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows'))">$(HyperCodecsWindowsTargets)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Allocation and throughput benchmarks for HyperCodecs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HyperCodecs\HyperCodecs.csproj" />
    <ProjectReference Include="..\..\HyperCodecs.Platform\HyperCodecs.Platform.csproj" />
    <ProjectReference Include="..\..\HyperCodecs.Platform.Linux\HyperCodecs.Platform.Linux.csproj" />
  </ItemGroup>

  <!-- Lists the benchmarks for the allocation harness, so no reflection finds or calls them. -->
  <ItemGroup>
    <ProjectReference Include="..\HyperCodecs.Benchmarks.Generator\HyperCodecs.Benchmarks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <!-- Short files coded by each layer, which the decoding benchmarks decode. -->
  <ItemGroup>
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\opus-stereo-music.opus" Link="Fixtures\opus-stereo-music.opus" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\silk-mono-wb-20ms.opus" Link="Fixtures\silk-mono-wb-20ms.opus" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\opus-mono-voip.opus" Link="Fixtures\opus-mono-voip.opus" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\av-h264-aac-text.mp4" Link="Fixtures\av-h264-aac-text.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\aac-lc-stereo-fragmented.mp4" Link="Fixtures\aac-lc-stereo-fragmented.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\av-h264-aac-text.mkv" Link="Fixtures\av-h264-aac-text.mkv" CopyToOutputDirectory="PreserveNewest" />
    <!-- MP3, FLAC, Vorbis and AAC files for the audio decoding and container benchmarks. -->
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\*.mp3" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\*.ogg" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\aac-lc-*.m4a" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\aac-lc-stereo-44100.aac" Link="Fixtures\aac-lc-stereo-44100.aac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\sine-16-stereo-44100.flac" Link="Fixtures\sine-16-stereo-44100.flac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\sine-24-stereo-48000.flac" Link="Fixtures\sine-24-stereo-48000.flac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\six-16-32000.flac" Link="Fixtures\six-16-32000.flac" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\noise-16-mono-22050.flac" Link="Fixtures\noise-16-mono-22050.flac" CopyToOutputDirectory="PreserveNewest" />
    <!-- Predicted H.264 and H.265 files, which the video decoding benchmarks decode. -->
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\h264-*.mp4" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\HyperCodecs.Tests\Fixtures\h265-*.mp4" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
