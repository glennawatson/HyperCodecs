<Project>
  <PropertyGroup>
    <!-- The library, tests and benchmarks build for .NET 10 (LTS) and .NET 11. -->
    <LibraryTargetFrameworks>net10.0;net11.0</LibraryTargetFrameworks>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>

    <!-- HyperCodecs.Platform builds one assembly for each system, and each build holds only that system's code. Linux has no
         platform target framework, so it is the separate HyperCodecs.Platform.Linux project. Apple targets build on macOS and Windows only. -->
    <HyperCodecsWindowsTargets>net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</HyperCodecsWindowsTargets>
    <HyperCodecsAppleTargets>net10.0-ios;net10.0-tvos;net10.0-macos;net10.0-maccatalyst;net11.0-ios;net11.0-tvos;net11.0-macos;net11.0-maccatalyst</HyperCodecsAppleTargets>
    <HyperCodecsAndroidTargets>net10.0-android36.0;net11.0-android37</HyperCodecsAndroidTargets>
    <HyperCodecsPlatformTargetFrameworks>$(LibraryTargetFrameworks);$(HyperCodecsWindowsTargets)</HyperCodecsPlatformTargetFrameworks>

    <!-- The Android SDK is not installed on the Linux and Windows arm64 hosted runners, so the Android targets build on every other host. -->
    <HyperCodecsHostIsArm64 Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">true</HyperCodecsHostIsArm64>
    <HyperCodecsPlatformTargetFrameworks Condition="'$(HyperCodecsHostIsArm64)' != 'true' or $([MSBuild]::IsOsPlatform('OSX'))">$(HyperCodecsPlatformTargetFrameworks);$(HyperCodecsAndroidTargets)</HyperCodecsPlatformTargetFrameworks>
    <HyperCodecsPlatformTargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows')) or $([MSBuild]::IsOsPlatform('OSX'))">$(HyperCodecsPlatformTargetFrameworks);$(HyperCodecsAppleTargets)</HyperCodecsPlatformTargetFrameworks>

    <!-- Lets Linux and macOS build the net*-windows targets. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <MinVerTagPrefix></MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerAutoIncrement>patch</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <Authors>Glenn Watson</Authors>
    <Company>Glenn Watson</Company>
    <Product>HyperCodecs</Product>
    <Copyright>Copyright (c) 2026 Glenn Watson</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/glennawatson/HyperCodecs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable;CS4014</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Only HyperCodecs, HyperCodecs.Platform and HyperCodecs.Platform.Linux ship as NuGet packages; they opt back in. -->
    <IsPackable>false</IsPackable>

    <IsTestProject Condition="'$(IsTestProject)' == ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '(^|\.)Tests$'))</IsTestProject>
    <IsBenchmarkProject Condition="'$(IsBenchmarkProject)' == ''">$(MSBuildProjectName.EndsWith('Benchmarks'))</IsBenchmarkProject>
  </PropertyGroup>

  <!-- .NET 11 compiles async methods to runtime async state machines. -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0')) and '$(DisableRuntimeAsync)' != 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Every shipped assembly must be trim and Native AOT safe. The Roslyn generator loads into the compiler as netstandard2.0. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(IsBenchmarkProject)' != 'true' and '$(MSBuildProjectName)' != 'HyperCodecs.Benchmarks.Generator'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TUnitImplicitUsings>true</TUnitImplicitUsings>
    <TUnitAssertionsImplicitUsings>true</TUnitAssertionsImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <None Include="$(MSBuildThisFileDirectory)testconfig.json">
      <Link>$(AssemblyName).testconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- System.Threading.Lock on .NET 9+. -->
  <ItemGroup>
    <Using Include="System.Threading.Lock" Alias="Lock" />
  </ItemGroup>

  <!-- Analyzer set shared with ReactiveUI. -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="StyleSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PerformanceSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SecuritySharp.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
