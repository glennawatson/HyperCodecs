<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Sound and video containers and codecs written in managed C#: no native library is loaded. Everything reads and writes spans and is safe to trim and compile ahead of time.</Description>
    <RootNamespace>HyperCodecs</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package. Authors, licence and repository come from Directory.Build.props; MinVer sets the version. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HyperCodecs</PackageId>
    <Title>HyperCodecs</Title>
    <PackageTags>audio;video;codec;aac;flac;mp3;opus;vorbis;h264;h265;hevc;mp4;matroska;ogg;aot</PackageTags>
    <PackageProjectUrl>https://github.com/glennawatson/HyperCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- The PDB is embedded in the assembly (DebugType embedded), so there is no separate symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- The NuGet package can be loaded by Mono hosts (Blazor WebAssembly, some mobile targets) that may not run
       runtime-async methods, so packing keeps compiler state machines. `dotnet pack` sets _IsPacking;
       HyperCodecsPackageBuild=true forces the package codegen in any other build, and the NuGet release workflow
       (which builds before it packs) is detected from GITHUB_WORKFLOW_REF. -->
  <PropertyGroup Condition="'$(_IsPacking)' == 'true' or '$(HyperCodecsPackageBuild)' == 'true' or $(GITHUB_WORKFLOW_REF.Contains('/release.yml'))">
    <Features>$(Features.Replace('runtime-async=on', 'runtime-async=off'))</Features>
  </PropertyGroup>

  <!-- Recompile when the runtime-async setting changes between a development build and a pack in the same folder. -->
  <ItemGroup>
    <CoreCompileCache Include="$(Features)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/hypercodecs/PACKAGE-README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperCodecs.Platform" />
    <InternalsVisibleTo Include="HyperCodecs.Tests" />
    <InternalsVisibleTo Include="HyperCodecs.Benchmarks" />
  </ItemGroup>
</Project>
