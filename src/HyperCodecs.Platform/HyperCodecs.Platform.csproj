<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Operating system sound output (WASAPI, CoreAudio, PulseAudio or PipeWire) and hardware video decoding (Media Foundation, VideoToolbox, VA-API) for HyperCodecs. Each part loads its system library at run time and reports when it is missing, so the managed decoders in HyperCodecs remain the fallback.</Description>
    <RootNamespace>HyperCodecs.Platform</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package. Authors, licence and repository come from Directory.Build.props; MinVer sets the version. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HyperCodecs.Platform</PackageId>
    <Title>HyperCodecs.Platform</Title>
    <PackageTags>audio;video;hardware;wasapi;coreaudio;pulseaudio;videotoolbox;mediafoundation;vaapi;h264;h265</PackageTags>
    <PackageProjectUrl>https://github.com/glennawatson/HyperCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- The PDB is embedded in the assembly (DebugType embedded), so there is no separate symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Packing keeps compiler state machines so Mono hosts can load the package; see HyperCodecs.csproj. -->
  <PropertyGroup Condition="'$(_IsPacking)' == 'true' or '$(HyperCodecsPackageBuild)' == 'true' or $(GITHUB_WORKFLOW_REF.Contains('/release.yml'))">
    <Features>$(Features.Replace('runtime-async=on', 'runtime-async=off'))</Features>
  </PropertyGroup>

  <ItemGroup>
    <CoreCompileCache Include="$(Features)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/hypercodecs/PLATFORM-README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperCodecs\HyperCodecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperCodecs.Tests" />
    <InternalsVisibleTo Include="HyperCodecs.Benchmarks" />
  </ItemGroup>
</Project>
